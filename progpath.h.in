#ifndef MAXPATHLEN
#  ifdef PATH_MAX
#    define MAXPATHLEN PATH_MAX
#  else
#    define MAXPATHLEN 4096
#  endif
#endif

static char progpath_ipwd[MAXPATHLEN] = {0};

struct method {
  int id;
  int line;
  const char *label;
  int debug;
};

static struct method
make_method(int *id, int line, const char *label, int debug) {
  struct method m = {(*id)++, line, label, debug};
  return m;
}

#define METHOD(x) make_method(&method, __LINE__, (x), debug)

enum {
  PP_DEFAULT = 0,
  PP_PRINT = 1 << 0,
  PP_CONTINUE = 1 << 1
};

static int pp_get_debug(void) {
  const char *env = getenv("PROGPATH_DEBUG");
  return env ? atoi(env) : 0;
}

static void pp_print(const char *fmt, ...) {
  va_list args;
  if (!(pp_get_debug() & PP_PRINT))
    return;

  va_start(args, fmt);
  vfprintf(stderr, fmt, args);
  va_end(args);
}

static void print_method(struct method m, const char *result) {
  pp_print("Method %02d, line %04d: %s=[%s]\n", m.id, m.line, m.label, result);
}

static int is_path_absolute(const char *path) {
  if (!path || path[0] == '\0')
    return 0;
  if (path[0] == '/')
    return 1;
  if (
#ifdef HAVE_CTYPE_H
      isalpha(path[0]) &&
#endif
      path[1] == ':' && (path[2] == '\\' || path[2] == '/'))
    return 1;
  if (path[0] == '\\' && path[1] == '\\')
    return 1;
  return 0;
}

#if !defined(PROGPATH_UTF8) || !defined(HAVE_WINDOWS_H)
static int path_has_separator(const char *path) {
  if (!path)
    return 0;

  while (*path) {
    if (*path == '/' || *path == '\\')
      return 1;
    path++;
  }

  return 0;
}
#endif

#ifdef PROGPATH_UTF8
/* Validate RFC 3629 UTF-8, rejecting overlong forms, surrogates, and
 * code points above U+10FFFF. */
static int is_valid_utf8(const char *str) {
  const unsigned char *s = (const unsigned char *)str;

  if (!s)
    return 0;

  while (*s) {
    if (*s <= 0x7f) {
      s++;
    } else if (*s >= 0xc2 && *s <= 0xdf) {
      if (s[1] < 0x80 || s[1] > 0xbf)
        return 0;
      s += 2;
    } else if (*s == 0xe0) {
      if (s[1] < 0xa0 || s[1] > 0xbf || s[2] < 0x80 || s[2] > 0xbf)
        return 0;
      s += 3;
    } else if ((*s >= 0xe1 && *s <= 0xec) || (*s >= 0xee && *s <= 0xef)) {
      if (s[1] < 0x80 || s[1] > 0xbf || s[2] < 0x80 || s[2] > 0xbf)
        return 0;
      s += 3;
    } else if (*s == 0xed) {
      if (s[1] < 0x80 || s[1] > 0x9f || s[2] < 0x80 || s[2] > 0xbf)
        return 0;
      s += 3;
    } else if (*s == 0xf0) {
      if (s[1] < 0x90 || s[1] > 0xbf || s[2] < 0x80 || s[2] > 0xbf ||
          s[3] < 0x80 || s[3] > 0xbf)
        return 0;
      s += 4;
    } else if (*s >= 0xf1 && *s <= 0xf3) {
      if (s[1] < 0x80 || s[1] > 0xbf || s[2] < 0x80 || s[2] > 0xbf ||
          s[3] < 0x80 || s[3] > 0xbf)
        return 0;
      s += 4;
    } else if (*s == 0xf4) {
      if (s[1] < 0x80 || s[1] > 0x8f || s[2] < 0x80 || s[2] > 0xbf ||
          s[3] < 0x80 || s[3] > 0xbf)
        return 0;
      s += 4;
    } else {
      return 0;
    }
  }

  return 1;
}
#endif

#if defined(PROGPATH_UTF8) && defined(HAVE_WINDOWS_H)
static char *wide_to_utf8(const WCHAR *wide) {
  char *utf8;
  int bytes;

  if (!wide)
    return NULL;

  bytes = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide, -1,
                              NULL, 0, NULL, NULL);
  if (bytes <= 0) {
    errno = EILSEQ;
    return NULL;
  }

  utf8 = (char *)calloc((size_t)bytes, sizeof(char));
  if (!utf8)
    return NULL;

  if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide, -1,
                          utf8, bytes, NULL, NULL) != bytes) {
    free(utf8);
    errno = EILSEQ;
    return NULL;
  }

  return utf8;
}

static char *win32_module_path_utf8(void) {
  DWORD capacity = MAXPATHLEN;

  for (;;) {
    WCHAR *wide = (WCHAR *)calloc((size_t)capacity, sizeof(WCHAR));
    DWORD length;
    char *utf8;

    if (!wide)
      return NULL;

    length = GetModuleFileNameW(NULL, wide, capacity);
    if (length > 0 && length < capacity) {
      wide[length] = L'\0';
      utf8 = wide_to_utf8(wide);
      free(wide);
      return utf8;
    }

    free(wide);
    if (length == 0 || capacity > 32768)
      return NULL;
    capacity *= 2;
  }
}

static char *win32_current_directory_utf8(void) {
  DWORD capacity = GetCurrentDirectoryW(0, NULL);

  if (capacity == 0)
    return NULL;

  for (;;) {
    WCHAR *wide = (WCHAR *)calloc((size_t)capacity, sizeof(WCHAR));
    DWORD length;
    char *utf8;

    if (!wide)
      return NULL;

    length = GetCurrentDirectoryW(capacity, wide);
    if (length > 0 && length < capacity) {
      utf8 = wide_to_utf8(wide);
      free(wide);
      return utf8;
    }

    free(wide);
    if (length == 0 || length > 32768)
      return NULL;
    capacity = length + 1;
  }
}
#endif

#if !defined(PROGPATH_UTF8) || !defined(HAVE_WINDOWS_H)
#  ifdef HAVE_UNISTD_H
static int is_executable_file(const char *path) {
#    ifdef HAVE_SYS_STAT_H
  struct stat st;
  if (stat(path, &st) != 0 || !S_ISREG(st.st_mode))
    return 0;
#    endif

  return access(path, X_OK) == 0;
}
#  endif

static void resolve_to_full_path(const char *ipwd, char *buf, size_t buflen) {
  char rbuf[MAXPATHLEN] = {0};

  if (!buf || buflen < 1)
    return;

  if (buflen > MAXPATHLEN)
    buflen = MAXPATHLEN;
  strncpy(rbuf, buf, buflen - 1);
  rbuf[MAXPATHLEN - 1] = '\0';

  if (!is_path_absolute(rbuf)) {
    if (rbuf[0] == '.' || path_has_separator(rbuf)) {
      char tmp[MAXPATHLEN] = {0};
      snprintf(tmp, MAXPATHLEN, "%s/%s", (ipwd && ipwd[0]) ? ipwd : ".", rbuf);
      strncpy(rbuf, tmp, MAXPATHLEN - 1);
    }
  }

  if (is_path_absolute(rbuf) || rbuf[0] == '.' || path_has_separator(rbuf)) {
#ifdef HAVE_REALPATH
    char rpbuf[MAXPATHLEN] = {0};
    if (realpath(rbuf, rpbuf)) {
      strncpy(rbuf, rpbuf, MAXPATHLEN - 1);
    }
#endif
  }

#ifdef HAVE_SEARCHPATHA
  if (!is_path_absolute(rbuf)) {
    char found[MAXPATHLEN] = {0};
    char *file_part = NULL;
    if (SearchPathA(NULL, rbuf, ".exe", MAXPATHLEN - 1, found, &file_part) > 0) {
      strncpy(rbuf, found, MAXPATHLEN - 1);
    }
  }
#endif

  if (!is_path_absolute(rbuf)) {
    char *path_env = getenv("PATH");
    if (path_env) {
      char *path_dup = strdup(path_env);
      if (path_dup) {
#ifdef HAVE_UNISTD_H
        char *dir = path_dup;
        for (;;) {
          char *separator = strchr(dir, ':');
          char full_path[MAXPATHLEN] = {0};
          if (separator)
            *separator = '\0';

          /* An empty PATH component denotes the current directory. */
          if (dir[0] == '\0') {
            snprintf(full_path, MAXPATHLEN, "%s/%s", (ipwd && ipwd[0]) ? ipwd : ".", rbuf);
          } else if (!is_path_absolute(dir) && ipwd && ipwd[0]) {
             snprintf(full_path, MAXPATHLEN, "%s/%s/%s", ipwd, dir, rbuf);
          } else {
             snprintf(full_path, MAXPATHLEN, "%s/%s", dir, rbuf);
          }
          if (is_executable_file(full_path)) {
            strncpy(rbuf, full_path, MAXPATHLEN - 1);
            break;
          }
          if (!separator)
            break;
          dir = separator + 1;
        }
#endif
        free(path_dup);
      }
    }
  }

  if (is_path_absolute(rbuf)) {
#ifdef HAVE_REALPATH
    char rpbuf[MAXPATHLEN] = {0};
    if (realpath(rbuf, rpbuf)) {
      strncpy(rbuf, rpbuf, MAXPATHLEN - 1);
    }
#endif
    strncpy(buf, rbuf, buflen - 1);
    buf[buflen - 1] = '\0';
  }
}

static void finalize(struct method m, const char *ipwd, char *buf, size_t buflen, const char *result) {
  if (!buf || buflen < 1)
    return;

  if (result)
    strncpy(buf, result, buflen - 1);

  if (buf[0] == 0)
    return;

  print_method(m, buf);
  resolve_to_full_path(ipwd, buf, buflen);
  print_method(m, buf);
}
#endif

static int we_done_yet(struct method m, char **buf, size_t buflen, const char *path) {
  size_t pathlen;
  if (!path)
    return 0;

#ifdef PROGPATH_UTF8
  if (!is_valid_utf8(path)) {
    errno = EILSEQ;
    return 0;
  }
#endif

  pathlen = strlen(path);
  if (pathlen < 2)
    return 0;

  if (is_path_absolute(path)) {

    if (buf && !(*buf)) {
#ifdef PROGPATH_UTF8
      buflen = pathlen + 1;
#else
      buflen = MAXPATHLEN;
#endif
      *buf = (char *)calloc(buflen, sizeof(char));
      assert(buf && *buf && (*buf)[0] == '\0');
    }
    if (buf && *buf && buflen > 0) {
#ifdef PROGPATH_UTF8
      if (pathlen >= buflen) {
        (*buf)[0] = '\0';
        return 0;
      }
#endif
      strncpy(*buf, path, buflen - 1);
      (*buf)[buflen - 1] = '\0';
    }

    if (m.debug & PP_CONTINUE)
      return 0;
    return 1;
  }

  return 0;
}

static char *progcwd(char *buf, size_t buflen) {
  int debug = pp_get_debug();
  int method = 0;

  pp_print("progcwd() getting the current directory\n");

#if defined(PROGPATH_UTF8) && defined(HAVE_WINDOWS_H)
  {
    char *cwd = win32_current_directory_utf8();
    struct method m = METHOD("GetCurrentDirectoryW+UTF-8");
    m.debug &= ~PP_CONTINUE;
    if (cwd) {
      print_method(m, cwd);
      if (we_done_yet(m, &buf, buflen, cwd)) {
        free(cwd);
        return buf;
      }
      free(cwd);
    }
    return NULL;
  }
#else

#ifdef HAVE_GETCWD
  {
    char cwd[MAXPATHLEN] = {0};
    char mbuf[MAXPATHLEN] = {0};
    struct method m = METHOD("getcwd");
    getcwd(cwd, MAXPATHLEN);
    finalize(m, NULL, mbuf, MAXPATHLEN, cwd);
    if (we_done_yet(m, &buf, buflen, mbuf))
      return buf;
  }
#endif

#if defined(HAVE__GETCWD) && defined(HAVE_DIRECT_H)
  {
    char cwd[MAXPATHLEN] = {0};
    char mbuf[MAXPATHLEN] = {0};
    struct method m = METHOD("_getcwd");
    _getcwd(cwd, MAXPATHLEN);
    finalize(m, NULL, mbuf, MAXPATHLEN, cwd);
    if (we_done_yet(m, &buf, buflen, mbuf))
      return buf;
  }
#endif

#ifdef HAVE_REALPATH
  {
    char cwd[MAXPATHLEN] = {0};
    char mbuf[MAXPATHLEN] = {0};
    struct method m = METHOD("realpath(.)");
    realpath(".", cwd);
    finalize(m, NULL, mbuf, MAXPATHLEN, cwd);
    if (we_done_yet(m, &buf, buflen, mbuf))
      return buf;
  }
#endif

#ifdef HAVE_GETCURRENTDIRECTORY
  {
    char cwd[MAXPATHLEN] = {0};
    char mbuf[MAXPATHLEN] = {0};
    struct method m = METHOD("GetCurrentDirectory");
    GetCurrentDirectory(MAXPATHLEN, cwd);
    finalize(m, NULL, mbuf, MAXPATHLEN, cwd);
    if (we_done_yet(m, &buf, buflen, mbuf))
      return buf;
  }
#endif

  {
    struct method m = METHOD("UNKNOWN");
    if (we_done_yet(m, &buf, buflen, NULL))
      return buf;
  }

  if (buf && buf[0] != '\0')
    return buf;
  return NULL;
#endif
}


#ifdef __cplusplus
extern "C" {
#endif
char *progipwd(char *buf, size_t buflen) {
#if !defined(PROGPATH_UTF8) || !defined(HAVE_WINDOWS_H)
  int debug = pp_get_debug();
  int method = 0;
#endif
  struct method im = {0, __LINE__, "ipwd", 0};

  pp_print("=== progipwd() ===\n");

#ifdef PROGPATH_UTF8
  if (buf && buflen > 0)
    buf[0] = '\0';
#endif

  if (progpath_ipwd[0]) {
#ifdef PROGPATH_UTF8
    if (we_done_yet(im, &buf, buflen, progpath_ipwd))
      return buf;
    return NULL;
#else
    we_done_yet(im, &buf, buflen, progpath_ipwd);
    return buf;
#endif
  }

#if defined(PROGPATH_UTF8) && defined(HAVE_WINDOWS_H)
  return progcwd(buf, buflen);
#else

  {
    char cwd[MAXPATHLEN] = {0};
    char mbuf[MAXPATHLEN] = {0};
    char *pwd;
    struct method m = METHOD("getenv(PWD)");
    pwd = getenv("PWD");
    if (pwd) {
      strncpy(cwd, pwd, MAXPATHLEN - 1);
      cwd[MAXPATHLEN - 1] = '\0';
      finalize(m, NULL, mbuf, MAXPATHLEN, cwd);
      if (we_done_yet(m, &buf, buflen, mbuf))
        return buf;
    }
  }

  {
    char cwd[MAXPATHLEN] = {0};
    char pbuf[MAXPATHLEN] = {0};

    pp_print("progipwd() using the current directory\n");

    progcwd(cwd, MAXPATHLEN);
    finalize(im, NULL, pbuf, MAXPATHLEN, cwd);
    if (we_done_yet(im, &buf, buflen, pbuf))
      return buf;
  }

  if (buf && buf[0] != '\0')
    return buf;
  return NULL;
#endif
}

char *progpath(char *buf, size_t buflen) {
  int debug = pp_get_debug();
  int method = 0;

  char cwd[MAXPATHLEN] = {0};
  char ipwd[MAXPATHLEN] = {0};

  pp_print("=== progpath() ===\n");

#ifdef PROGPATH_UTF8
  if (buf && buflen > 0)
    buf[0] = '\0';
#endif

  progcwd(cwd, MAXPATHLEN);
  progipwd(ipwd, MAXPATHLEN);

  pp_print("cwd=%s ipwd=%s\n", cwd, ipwd);

#if defined(PROGPATH_UTF8) && defined(HAVE_WINDOWS_H)
  {
    char *path = win32_module_path_utf8();
    struct method m = METHOD("GetModuleFileNameW+UTF-8");
    m.debug &= ~PP_CONTINUE;
    if (path) {
      print_method(m, path);
      if (we_done_yet(m, &buf, buflen, path)) {
        free(path);
        return buf;
      }
      free(path);
    }
    return NULL;
  }
#else

  /*
   * Tier 1: authoritative operating-system interfaces that identify the
   * running executable directly.  Keep these ahead of argv/process-name
   * methods: a basename resolved through PATH can name a different program.
   *
   * Several of these interfaces coexist on a platform.  Their relative
   * ordering is intentionally the same as the historical fallback order.
   */

#ifdef HAVE_GETMODULEFILENAMEA
  {
    char mbuf[MAXPATHLEN] = {0};
    DWORD ret = GetModuleFileNameA(NULL, mbuf, MAXPATHLEN);
    struct method m = METHOD("GetModuleFileNameA");
    if (ret > 0 && ret < MAXPATHLEN) {
      finalize(m, ipwd, mbuf, MAXPATHLEN, NULL);
      if (we_done_yet(m, &buf, buflen, mbuf)) {
          return buf;
      }
    }
  }
#endif

#ifdef HAVE_PROC_PIDPATH
  {
    char mbuf[MAXPATHLEN] = {0};
    struct method m = METHOD("proc_pidpath");
    (void)proc_pidpath(getpid(), mbuf, MAXPATHLEN);
    finalize(m, ipwd, mbuf, MAXPATHLEN, NULL);
    if (we_done_yet(m, &buf, buflen, mbuf)) {
      return buf;
    }
  }
#endif

#if defined(HAVE_DECL_CTL_KERN) && defined(HAVE_DECL_KERN_PROC) && defined(HAVE_DECL_KERN_PROC_PATHNAME)
  {
    char mbuf[MAXPATHLEN] = {0};
    size_t len = MAXPATHLEN - 1;
    int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PATHNAME, -1};
    struct method m = METHOD("sysctl(KERN_PROC)");
    sysctl(mib, 4, mbuf, &len, NULL, 0);
    finalize(m, ipwd, mbuf, MAXPATHLEN, NULL);
    if (we_done_yet(m, &buf, buflen, mbuf)) {
      return buf;
    }
  }
#endif

#if defined(HAVE_DECL_CTL_KERN) && defined(HAVE_DECL_KERN_PROC_ARGS) && defined(HAVE_DECL_KERN_PROC_PATHNAME)
  {
    char mbuf[MAXPATHLEN] = {0};
    size_t len = MAXPATHLEN - 1;
    int mib[4] = {CTL_KERN, KERN_PROC_ARGS, getpid(), KERN_PROC_PATHNAME};
    struct method m = METHOD("sysctl(KERN_PROC_ARGS)");
    if (sysctl(mib, 4, mbuf, &len, NULL, 0) == 0) {
      if (len >= MAXPATHLEN)
        len = MAXPATHLEN - 1;
      mbuf[len] = '\0';
    }
    finalize(m, ipwd, mbuf, MAXPATHLEN, NULL);
    if (we_done_yet(m, &buf, buflen, mbuf)) {
      return buf;
    }
  }
#endif

#ifdef HAVE__NSGETEXECUTABLEPATH
  {
