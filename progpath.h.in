    int index = 0;
    pid_t proc1 = (pid_t)0;
    int proccnt;
    struct method m = METHOD("getprocs64");

    proccnt = getprocs64(NULL, 0, NULL, 0, &proc1, 1000000);
    pentry = (struct procentry64 *)calloc(proccnt, sizeof(struct procentry64));
    while ((numproc = getprocs64(pentry, sizeof(struct procentry64), NULL, 0, &index, proccnt)) > 0) {
      for (int i = 0; i < numproc; i++) {
        if (pentry[i].pi_state == SZOMB)
          continue;
        if (getpid() == (int)pentry[i].pi_pid) {
          argv0 = pentry[i].pi_comm;
          finalize(m, ipwd, mbuf, MAXPATHLEN, argv0);
          break;
        }
      }
    }
    free(pentry);
    if (we_done_yet(m, &buf, buflen, mbuf)) {
      return buf;
    }
  }
#endif

  {
    struct method m = METHOD("UNKNOWN");
    if (we_done_yet(m, &buf, buflen, NULL)) {
      return buf;
    }
  }



  if (buf && buf[0] != '\0')
    return buf;
  return NULL;
#endif
}
#ifdef __cplusplus
}
#endif

static void proginit(void) {
  if (progpath_ipwd[0] != '\0')
    return;

  progipwd(progpath_ipwd, MAXPATHLEN);
}

#ifdef __cplusplus
struct progpath_initializer {
  progpath_initializer() {
    proginit();
  }
  ~progpath_initializer() {
  }
};

static progpath_initializer pp;
#endif

#if defined(HAVE_ATTRIBUTE_CONSTRUCTOR)
__attribute__((constructor)) void progpath_c_initializer(void) {
  proginit();
}
#elif defined(HAVE_PRAGMA_SECTION)
#  if defined(read)
#    define read_saved read
#    undef read
#  endif
#  pragma section(".CRT$XCU",read)
#  if defined(read_saved) && !defined(read)
#    define read read_saved
#  endif
__declspec(allocate(".CRT$XCU")) void (* const progpath_c_initializer)(void) = proginit;
#endif

#endif /* PROGPATH_IMPLEMENTATION */


#endif /* PROGPATH_H */
