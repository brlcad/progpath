    struct method m = METHOD("_NSGetExecutablePath");
    _NSGetExecutablePath(mbuf, &ulen);
    finalize(m, ipwd, mbuf, MAXPATHLEN, NULL);
    if (we_done_yet(m, &buf, buflen, mbuf)) {
      return buf;
    }
  }
