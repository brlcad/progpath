/*
 * When building or consuming the static library on Windows, define
 * PROGPATH_STATIC before including this header.  The exported
 * progpath-static CMake target does this automatically.
 */
#ifndef PROGPATH_EXPORT
#  if defined(_WIN32) || defined(__CYGWIN__)
#    if defined(PROGPATH_STATIC)
#      define PROGPATH_EXPORT
#    elif defined(PROGPATH_EXPORTS)
#      define PROGPATH_EXPORT __declspec(dllexport)
#    elif defined(PROGPATH_IMPLEMENTATION)
#      define PROGPATH_EXPORT
#    else
#      define PROGPATH_EXPORT __declspec(dllimport)
#    endif
#  else
#    if defined(__GNUC__) && __GNUC__ >= 4
#      define PROGPATH_EXPORT __attribute__((visibility("default")))
#    else
#      define PROGPATH_EXPORT
#    endif
#  endif
#endif

/**
 * @section Initialization
 *
 * progpath captures the application's initial working directory (ipwd)
 * once, as early as possible, so that progipwd() can return it correctly
 * even after the process has called chdir().  When and how this capture
 * happens depends on how you link the library:
 *
 * **Shared library** (libprogpath.so / .dylib / .dll):
 *   A C++ static constructor runs automatically before main().  No
 *   action required from the caller.
 *
 * **Static library linked from C++** (-lprogpath-static, compiled as C++):
 *   Same as above — the C++ runtime fires the static constructor.
 *
 * **Static library linked from pure C** (-lprogpath-static, no C++ runtime):
 *   A C static constructor runs automatically before main(). No action
 *   required from the caller.
 *
 * Thread safety: concurrent calls before the first capture completes
 * are not guaranteed safe.  Initialize from the main thread before
 * spawning other threads.
 *
 * When PROGPATH_UTF8 is configured, successful results are guaranteed
 * to be valid UTF-8. Windows UTF-16 paths are converted strictly;
 * byte-oriented platforms reject invalid UTF-8 with errno set to EILSEQ.
 * A caller buffer too small for the complete result is rejected instead
 * of receiving a partial UTF-8 sequence. The len argument remains a byte
 * count and the public API is unchanged.
 */

/**
 * @brief Get the absolute filesystem path to the application's binary.
 *
 * A path string will be written to the provided 'buf' buffer. It will write
 * at most 'len'-1 bytes to ensure null-termination.
 *
 * If 'buf' is NULL, memory will be dynamically allocated via calloc() and
 * the caller is responsible for calling free().
 *
 * @param buf Buffer to write the path to, or NULL to allocate memory.
 * @param len Size of the buffer in bytes.
 * @return Pointer to the buffer containing the path (either 'buf' or allocated), or NULL on failure.
 */
PROGPATH_EXPORT extern char *progpath(char *buf, size_t len);

/**
 * @brief Get the absolute path to the application's initial working directory.
 *
 * This obtains the current directory of the application as it was on entry to
 * main().
 *
 * A path string will be written to the provided 'buf' buffer. It will write
 * at most 'len'-1 bytes to ensure null-termination.
 *
 * If 'buf' is NULL, memory will be dynamically allocated via calloc() and
 * the caller is responsible for calling free().
 *
 * @param buf Buffer to write the path to, or NULL to allocate memory.
 * @param len Size of the buffer in bytes.
 * @return Pointer to the buffer containing the path (either 'buf' or allocated), or NULL on failure.
 */
PROGPATH_EXPORT extern char *progipwd(char *buf, size_t len);

#ifdef __cplusplus
}
#endif

